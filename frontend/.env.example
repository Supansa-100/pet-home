# ==========================================
# PET-HOME FRONTEND — ตัวอย่าง Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ  (cp .env.example .env)
# ==========================================
#
# หมายเหตุสำคัญ: Vite ฝังค่าเหล่านี้ลง bundle ตอน build ไม่ใช่ตอนรัน
# แก้ค่าแล้วต้อง build ใหม่เสมอ (บน Vercel ต้องกด Redeploy)
#
# ทุกตัวแปรที่ต้องการให้โค้ดฝั่งเบราว์เซอร์มองเห็น ต้องขึ้นต้นด้วย VITE_ เท่านั้น

# ─── URL ของ Backend ───
# ใส่แค่ origin เท่านั้น ห้ามมี /api ต่อท้าย และห้ามมี / ปิดท้าย
#
#   เว้นว่าง  = backend อยู่โดเมนเดียวกัน
#               (ตอน dev จะวิ่งผ่าน proxy ของ Vite / ตอนรันใน container เดียว)
#   ใส่ค่า    = แยก deploy คนละโดเมน เช่น frontend บน Vercel + backend บน Render
#               ตัวอย่าง: VITE_BACKEND_URL=https://pethome-api.onrender.com
#
# ตอนพัฒนาบนเครื่องแนะนำให้ "เว้นว่างไว้" เพราะ proxy ใน vite.config.js
# จัดการให้อยู่แล้ว ถ้าใส่ absolute URL จะข้าม proxy ไปเจอเรื่อง CORS โดยไม่จำเป็น
VITE_BACKEND_URL=

# ─── ปลายทางที่ Vite dev server จะ proxy /api และ /uploads ไปให้ ───
# ใช้เฉพาะตอน npm run dev เท่านั้น ไม่ถูกฝังลง bundle
# รันใน Docker ให้ใช้ http://backend:5001 (docker-compose ตั้งค่านี้ให้อยู่แล้ว)
VITE_PROXY_TARGET=http://127.0.0.1:5001
