# ==========================================
# PET-HOME ENVIRONMENT VARIABLES EXAMPLE
# ==========================================

# ─── Server ───
PORT=5001
NODE_ENV=development

# ─── Database ───
# If using Docker (docker-compose up -d), use DB_HOST=127.0.0.1
# If running inside Docker, use DB_HOST=db
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=pethome_db
DB_USER=pethome_user
DB_PASSWORD=your_secure_password

# ─── Security / JWT ───
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# ─── CORS ───
FRONTEND_URL=http://localhost:5173
